# Configuration for the end-to-end suites: Selenium, Appium, the load test, and
# the DAST half of the security review.
#
# Committed on purpose. Every secret in here is a throwaway for a database that
# CI creates and destroys, exactly like .env.test — and for the same reason,
# nothing in this file may ever name a role or a password a real deployment
# uses. See backend/.env.test for the full argument.
#
# Use it explicitly; it is never loaded by default:
#
#     SENTINEL_ENV_FILE=backend/.env.ci make dev-backend
#
# Why not just run the suites against `make serve`
# ------------------------------------------------
# `make serve` runs ENVIRONMENT=prod, and three of its settings are individually
# fatal to an end-to-end run — each failing in a way that looks like an
# application bug rather than a configuration choice:
#
#   * RATE_LIMIT_ENABLED=true. Login is 10/minute per IP and 5 per 15 minutes
#     per email address. A 300-case login suite runs from one address, so cases
#     11 onward get a 429 and the console renders "Too many attempts" — every
#     assertion expecting "Invalid credentials" fails, and the failure message
#     accuses the login form.
#   * COOKIE_SECURE=true. The refresh cookie is then dropped over
#     http://localhost, so a driver signs in successfully and is bounced back
#     to /login on the next navigation.
#   * ENVIRONMENT=prod itself refuses to start with either of the above relaxed,
#     which is correct and is why this is a separate file rather than an edit.
#
# The limiter is not being disabled because it is inconvenient. It should still
# be *tested* — but as its own scenario, asserting that the 11th login is
# refused, rather than as background noise under every other assertion.

ENVIRONMENT=dev

# Its own role, `sentinel_app_ci`, for exactly the reason .env.test spells out
# at length: a Postgres ROLE is cluster-wide while a GRANT is per-database, so
# `sentinel_ci` being a separate database buys no isolation at all from the
# credential it logs in with. Sharing `sentinel_app` with the real deployment
# would mean this file either has to carry that deployment's rotated password
# — committed — or stops working the next time it is rotated correctly.
#
# Migration 0001 creates the role from APP_DB_ROLE when it is missing (roles
# being cluster-wide is what makes that idempotent), so a fresh CI container
# needs no setup step. Note that it creates and does not ALTER: an existing
# role keeps its existing password, which is the other half of why this must
# not name a role anything else uses.
DATABASE_URL=postgresql+asyncpg://sentinel_app_ci:sentinel_app_ci@localhost:5432/sentinel_ci
ADMIN_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ci
APP_DB_ROLE=sentinel_app_ci
APP_DB_PASSWORD=sentinel_app_ci

# Database 2: dev uses 0 and the pytest suite uses 1.
REDIS_URL=redis://localhost:6379/2

# JWT_SECRET is deliberately absent, and generated per run instead —
# see make e2e-serve. A signing key committed to this repository is a true
# positive for any secret scanner even when the database it guards is a
# throwaway, and there is no reason a test stack needs a stable one:
# nothing here has to verify a token minted by a previous run.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Both relaxed for the reasons above. Neither is acceptable in prod, and the
# settings validator enforces that — which is why ENVIRONMENT is dev here.
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=false

# Argon2 is deliberately NOT weakened here, unlike in .env.test.
#
# The load test's whole output is a latency distribution, and login at the real
# parameters costs 60-100ms of CPU that the test is supposed to see. Turning
# that down would produce a number that describes a configuration nobody
# deploys. The pytest suite can weaken it because it is measuring behaviour, not
# time; this file cannot.

# Raised from the defaults (10 + 5) because the baseline load profile is 100
# concurrent virtual users and the default ceiling is 15 connections. Past that
# SQLAlchemy queues on pool checkout for up to 30 seconds and the run reports
# multi-second p99s that are entirely this number — a queue, not the database
# and not the handlers. Postgres' own default max_connections is 100, so this
# plus the admin pool below still leaves headroom for psql and the workers.
DB_POOL_SIZE=40
DB_MAX_OVERFLOW=20

# The pre-auth pool: signup, login, refresh, logout. This is the ceiling on
# concurrent logins specifically, and it is a different pool from the one above
# — raising DB_POOL_SIZE alone does nothing for a login-heavy scenario.
ADMIN_DB_POOL_SIZE=20
ADMIN_DB_MAX_OVERFLOW=10

CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# The suites drive the console and the API on one origin, the way a real
# deployment does, so `npm run build` has to have run first.
SERVE_WEB_CONSOLE=true

# Left unset on purpose, and each is a supported state the suites should see:
# SMTP, VAPID and FCM (notification channels degrade visibly when unconfigured),
# AGENT_DIST_DIR (the download page says no build exists), and
# NOVELTY_MODEL_DIR (the API reports no novelty score, with a reason).
