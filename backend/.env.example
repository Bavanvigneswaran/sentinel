# Copy to backend/.env — never commit the copy.
# Settings are resolved from this file's *absolute* location, so it works no
# matter which directory you run make from. A repo-root .env also works.

ENVIRONMENT=dev

# Two roles by design: the app connects as the restricted `sentinel_app` role so
# Postgres RLS is actually enforced. `sentinel` is the owner (superuser) and is
# used only by Alembic, the test harness, and the pre-auth login/signup path.
DATABASE_URL=postgresql+asyncpg://sentinel_app:sentinel_app@localhost:5432/sentinel
ADMIN_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
APP_DB_ROLE=sentinel_app
APP_DB_PASSWORD=sentinel_app

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Must be False over plain http://localhost — Safari drops Secure cookies there.
# Set to true (with TLS) in production; the app refuses to boot in prod without it.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Off in dev: the Vite proxy sets no X-Forwarded-For, so every request shares the
# 127.0.0.1 bucket and a few failed logins would lock you out of your own machine.
RATE_LIMIT_ENABLED=false

# Phase 8 only — Claude API for AI Insights, separate from Claude Code billing
ANTHROPIC_API_KEY=

# NOTE: complex types are parsed as JSON by pydantic-settings.
# CORS_ORIGINS=http://localhost:5173 fails with an opaque error. Keep the brackets.
CORS_ORIGINS=["http://localhost:5173"]

# --- Phase 5: alerts + notifications ----------------------------------------
ALERT_EVALUATOR_INTERVAL_SECONDS=15

# All optional — email dispatch is a no-op (logged, not an error) while
# SMTP_HOST is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Also optional and off when unset. Generate a keypair once with py-vapid's
# `vapid --gen` (installed alongside pywebpush) and paste the two keys here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
