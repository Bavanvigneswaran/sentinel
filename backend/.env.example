# Copy to backend/.env — never commit the copy.
# Settings are resolved from this file's *absolute* location, so it works no
# matter which directory you run make from. A repo-root .env also works.

ENVIRONMENT=dev

# Two roles by design: the app connects as the restricted `sentinel_app` role so
# Postgres RLS is actually enforced. `sentinel` is the owner (superuser) and is
# used only by Alembic, the test harness, and the pre-auth login/signup path.
DATABASE_URL=postgresql+asyncpg://sentinel_app:sentinel_app@localhost:5432/sentinel
ADMIN_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
APP_DB_ROLE=sentinel_app
APP_DB_PASSWORD=sentinel_app

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Must be False over plain http://localhost — Safari drops Secure cookies there.
# Set to true (with TLS) in production; the app refuses to boot in prod without it.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Off in dev: the Vite proxy sets no X-Forwarded-For, so every request shares the
# 127.0.0.1 bucket and a few failed logins would lock you out of your own machine.
# MUST be true in prod, and the settings validator refuses to start otherwise:
# /auth/login guards a password and /enroll is the only unauthenticated write in
# the system, so both are the brute-forceable surface.
RATE_LIMIT_ENABLED=false

# NOTE: complex types are parsed as JSON by pydantic-settings.
# CORS_ORIGINS=http://localhost:5173 fails with an opaque error. Keep the brackets.
CORS_ORIGINS=["http://localhost:5173"]

# --- Phase 5: alerts + notifications ----------------------------------------
ALERT_EVALUATOR_INTERVAL_SECONDS=15

# All optional — email dispatch is a no-op (logged, not an error) while
# SMTP_HOST is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Also optional and off when unset. Generate a keypair once with py-vapid's
# `vapid --gen` (installed alongside pywebpush) and paste the two keys here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Phase 10a: FCM (Android push) --------------------------------------------
# Both must be set for the Android app to receive anything; either one missing
# is a logged no-op, exactly like SMTP and VAPID above. In the Firebase console:
# Project settings → General for the project id, → Service accounts → Generate
# new private key for the JSON. Keep the JSON out of the repo.
#
# The Android app needs the matching google-services.json placed at
# frontend/mobile/google-services.json — see frontend/mobile/README.md.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# --- Phase 8: incident insights ----------------------------------------------
# Nothing to configure. Incident summaries and root-cause analyses are
# generated locally from the signal bundle by app/insights/generator.py — no
# API key, no external call, and unlike SMTP/VAPID/FCM above there is no
# "unset" state to degrade into. The former ANTHROPIC_API_KEY /
# ANTHROPIC_HAIKU_MODEL / ANTHROPIC_SONNET_MODEL settings were removed; one
# left over in an existing .env is ignored, not read.
INSIGHTS_WORKER_INTERVAL_SECONDS=60

# --- Phase 9: analytics + reports --------------------------------------------
# An hourly sweep is plenty — a schedule's own cadence is daily at the finest.
REPORT_WORKER_INTERVAL_SECONDS=3600
REPORTS_DEFAULT_PERIOD_DAYS=30
REPORTS_MAX_PERIOD_DAYS=366

# --- Layer 4: multivariate novelty models -------------------------------------
# Where `make train-novelty` writes its trained per-device IsolationForests.
# Unset is a fully supported state: nothing has been trained, and the API
# reports no novelty score rather than inventing one. backend/var/ is
# gitignored — these are generated artifacts, rebuilt from TimescaleDB.
NOVELTY_MODEL_DIR=

# --- Phase 11: agent distribution ---------------------------------------------
# Where a CI run's manifest.json and its binaries were published. Unset is a
# fully supported state, not a broken one: /download then says no build exists
# for the visitor's OS and points at building from source, rather than offering
# a link that 404s. Same posture as unset SMTP/VAPID/FCM.
#
# A local build lands in agent/dist, so pointing this there is enough for a
# single-machine setup:
#   AGENT_DIST_DIR=/absolute/path/to/PDD_Project/agent/dist
AGENT_DIST_DIR=

# Optional. When set, the manifest is still read from AGENT_DIST_DIR but the
# binaries themselves are linked from here (a release host or CDN) instead of
# being streamed by this API — serving multi-megabyte files out of the app
# process is fine for a handful of installs and wrong at any scale.
AGENT_DOWNLOAD_BASE_URL=
