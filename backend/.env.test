# Test configuration. The suite creates and migrates `sentinel_test` itself.
ENVIRONMENT=test

# The suite has its OWN restricted role, `sentinel_app_test`, and this is the
# one line in this file that is a correctness decision rather than a setting.
#
# A Postgres ROLE is cluster-wide; a GRANT is per-database. So `sentinel_test`
# being its own database bought no isolation at all from the credential it
# connected with — the suite and the real deployment were sharing one login on
# one cluster, and this file is committed while a real deployment's password is
# not. Rotating `sentinel_app`'s password for the public Tailscale Funnel front
# door (an ALTER ROLE, correctly) therefore broke 222 tests that had nothing to
# do with it, and the only fixes available were to commit the live credential
# into the repo or to keep patching this file by hand after every rotation.
#
# A separate role removes the coupling rather than managing it: migration 0001
# already takes the role name from APP_DB_ROLE and creates it if it is missing
# (roles being cluster-wide is what makes that idempotent), and every later
# migration grants to the same setting, so this is genuinely just configuration.
#
# The password here is a throwaway for a database the suite drops and recreates
# on every run, on a local container. That is why it can be committed, and it is
# also why it must never be a role anything else uses.
DATABASE_URL=postgresql+asyncpg://sentinel_app_test:sentinel_app_test@localhost:5432/sentinel_test
ADMIN_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_test
APP_DB_ROLE=sentinel_app_test
APP_DB_PASSWORD=sentinel_app_test

REDIS_URL=redis://localhost:6379/1

# JWT_SECRET is deliberately absent, and generated per run instead —
# see tests/conftest.py. A signing key committed to this repository is a true
# positive for any secret scanner even when the database it guards is a
# throwaway, and there is no reason a test stack needs a stable one:
# nothing here has to verify a token minted by a previous run.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Tests run over https://test so httpx's cookie jar will actually store and
# replay a Secure cookie, which lets us assert the production flag.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# On, so the limiter is actually exercised. Individual tests raise the limits.
RATE_LIMIT_ENABLED=true

# Argon2 is deliberately weakened here — the real parameters cost ~80ms per hash
# and would add minutes to the suite. test_passwords.py asserts the production
# defaults separately.
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST=8192
ARGON2_PARALLELISM=1

CORS_ORIGINS=["http://localhost:5173"]
