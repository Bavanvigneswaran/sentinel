# The backend's base URL, as reachable *from the device running the app*.
#
# There is no Vite proxy here, so this points straight at FastAPI and carries
# NO /api prefix — the backend mounts /auth, /devices, /fleet at the root and
# the web app's /api is purely an artefact of the dev proxy. See src/config.ts.
#
#   Android emulator .............. http://10.0.2.2:8000   (the default)
#   iOS simulator ................. http://localhost:8000
#   Physical device on your LAN ... http://192.168.x.x:8000
#   Deployed ...................... https://sentinel.example.com
#
# Over plain http the backend must be running with COOKIE_SECURE=false, or the
# refresh cookie is never stored and every app restart logs you out.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
